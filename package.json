{
  "name": "project-horizon",
  "version": "1.0.0",
  "description": "System-Wide Multimodal Desktop & GUI Agent for Windows",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:agent": "npm run dev --prefix backend/agent-service",
    "dev:perception": "powershell -Command \"cd backend/perception-service; .venv/Scripts/uvicorn server:app --port 4200\"",
    "dev:all": "concurrently -k -n \"FE,AGENT,PERCEPT\" -c \"cyan,blue,magenta\" \"npm run dev:frontend\" \"npm run dev:agent\" \"npm run dev:perception\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:desktop": "concurrently -k -n \"FE,ELECTRON\" -c \"cyan,green\" \"npm run dev:frontend\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
    "start:desktop": "electron .",
    "build:agent": "npm run build --prefix backend/agent-service",
    "build:all": "npm run build:frontend && npm run build:agent && npm run build:electron",
    "test:frontend": "npm run test --prefix frontend",
    "test:agent": "npm run test --prefix backend/agent-service",
    "test:perception": "powershell -Command \"cd backend/perception-service; .venv/Scripts/pytest -v\"",
    "test:all": "npm run test:frontend && npm run test:agent && npm run test:perception",
    "test:lasso": "electron scripts/test_interactive_lasso.js",
    "test:step4c": "npm run build:electron && electron scripts/test_step4c_inprocess_agent.js",
    "test:gemini": "npm run build:electron && electron scripts/test_gemini_react_integration.js",
    "build:desktop": "npm run build:frontend && npm run build:electron",
    "package:dir": "npm run build:desktop && electron-builder --dir",
    "package:win": "npm run build:desktop && electron-builder --win",
    "security-check": "npm audit && npm audit --prefix frontend && npm audit --prefix backend/agent-service"
  },

  "keywords": [
    "desktop-agent",
    "computer-use",
    "gemini",
    "react",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
