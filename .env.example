# ==============================================================================
# PROJECT HORIZON — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and insert your real credentials.
# Note: In accordance with project-horizon.md §8.6, secrets in production are
# managed via Windows Credential Manager (DPAPI-backed). For local dev/testing,
# you can specify environment variables below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL PERSONAL GEMINI MODE (DEVELOPMENT ONLY)
# ------------------------------------------------------------------------------
# Production uses hosted Google sign-in; no provider key belongs in an installer.
# Set this flag only when intentionally testing your own personal key locally.
# HORIZON_GEMINI_DIRECT=1
# Personal Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Local Ollama Fallback Models (Hardware accelerated via RTX 4060 GPU / CPU)
OLLAMA_HOST=http://localhost:11434
# Vision & OCR fallback model
OLLAMA_VISION_MODEL=llama3.2-vision
# Text & normal tasks fallback model
OLLAMA_TEXT_MODEL=qwen2.5:3b




# ------------------------------------------------------------------------------
# 2. MICROSERVICE PORTS & NETWORKING
# ------------------------------------------------------------------------------
PORT_FRONTEND=5173
PORT_AGENT_SERVICE=4100
PORT_PERCEPTION_SERVICE=4200
WS_HUD_PATH=/ws/hud

# ------------------------------------------------------------------------------
# 3. SAFETY GATE & AUDIT LOGGING (§8.2 & §8.6)
# ------------------------------------------------------------------------------
# Path to local encrypted SQLite audit database
AUDIT_DB_PATH=./data/horizon_audit.db
# Retention window for full-resolution crops (in days) before automated rolling purge (§8.5)
RETENTION_DAYS=7
# Local project roots for FTS5 indexer (§3.2) separated by semicolons
INDEXED_PROJECT_ROOTS=E:\code\projects;C:\Users\Jay\Projects

# ------------------------------------------------------------------------------
# 4. LOCAL PERCEPTION WORKER (100% OFFLINE — NO API KEY NEEDED)
# ------------------------------------------------------------------------------
# YOLOv8 + PaddleOCR run locally via ONNX Runtime + DirectML
PERCEPTION_BACKEND=directml
